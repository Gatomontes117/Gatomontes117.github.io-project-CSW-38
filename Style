body {
    margin: 0;
    background-color: #050510;
    background-image: repeating-conic-gradient(#0b1030 0% 25%, #050510 0% 50%); /* checker pattern */
    background-size: 60px 60px;
    color: #fff;
    font-family: 'Courier New', Courier, monospace;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    overflow-x: hidden;
}

h1 {
    margin: 5px 0 0;
    font-size: 2.6rem;
    letter-spacing: 3px;
    color: #00ffcc;
    text-shadow: 0 0 10px #00ffcc;
}

.byline {
    margin: 4px 0 10px;
    font-size: 1.5rem;
    font-weight: bold;
    color: #ffe066;
    text-shadow: 0 0 8px rgba(255, 224, 102, 0.6);
}

.lore {
    max-width: 540px;
    margin: 0 0 12px;
    padding: 0 10px;
    font-size: 1rem;
    line-height: 1.5;
    text-align: center;
    color: #e6f7ff;
}

#scoreboard {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 10px;
}

canvas {
    border: 2px solid #00ffcc;
    background: radial-gradient(circle, #111530 0%, #050510 100%);
    box-shadow: 0 0 20px rgba(0, 255, 204, 0.3);
}

#saucers {
    position: fixed;
    left: 0;
    top: 0;
    width: calc(50vw - 310px);
    min-width: 100px;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
    pointer-events: none;
}

#saucers img {
    width: 120px;
    max-width: 90%;
}

@media (max-width: 1000px) {
    body {
        padding-top: 90px;
        box-sizing: border-box;
    }
    #saucers {
        width: 100vw;
        min-width: 0;
        height: 90px;
        flex-direction: row;
    }
    #saucers img {
        width: 80px;
    }
}

/* ---------- Animated Play button ---------- */
#playAgain {
    position: relative;
    margin-top: 10px;
    padding: 8px 24px;
    font-family: inherit;
    font-size: 18px;
    color: #00ffcc;
    background: #050510;
    border: 2px solid #00ffcc;
    border-radius: 4px;
    cursor: pointer;
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.25s ease,
                background 0.25s ease, color 0.25s ease;
}

/* Glowing pulse only while the button is clickable (game over) */
#playAgain:not(:disabled) {
    animation: pulse 1.4s ease-in-out infinite;
}

/* Light sweep across the button on hover */
#playAgain::after {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.5), transparent);
    transition: left 0.5s ease;
}

#playAgain:hover:not(:disabled) {
    background: #00ffcc;
    color: #050510;
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0, 255, 204, 0.6);
    animation: none;
}

#playAgain:hover:not(:disabled)::after {
    left: 140%;
}

/* Press effect */
#playAgain:active:not(:disabled) {
    transform: translateY(1px) scale(0.94);
    box-shadow: 0 0 8px rgba(0, 255, 204, 0.8);
}

#playAgain:focus-visible {
    outline: 2px dashed #87ceeb;
    outline-offset: 4px;
}

#playAgain:disabled {
    opacity: 0.4;
    cursor: not-allowed;
}

@keyframes pulse {
    0%, 100% { box-shadow: 0 0 4px rgba(0, 255, 204, 0.4); }
    50%      { box-shadow: 0 0 22px rgba(0, 255, 204, 0.9); }
}

@media (prefers-reduced-motion: reduce) {
    #playAgain, #playAgain::after { transition: none; }
    #playAgain:not(:disabled) { animation: none; }
}

.instructions {
    margin: 12px 0 20px;
    padding: 10px 20px;
    max-width: 540px;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid #87ceeb;
    border-radius: 6px;
    color: #e6f7ff;
    font-size: 1rem;
}

.instructions h2 {
    margin: 0 0 6px;
    font-size: 1.2rem;
    color: #87ceeb;
}

.instructions ul {
    margin: 0;
    padding: 0;
    list-style: none;
}

.instructions li {
    margin: 6px 0;
}

kbd {
    display: inline-block;
    min-width: 22px;
    padding: 2px 8px;
    margin-right: 4px;
    text-align: center;
    font-family: inherit;
    font-weight: bold;
    color: #050510;
    background: #00ffcc;
    border-radius: 4px;
    box-shadow: 0 2px 0 #008f73;
}